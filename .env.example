# Rename this file to ".env" and fill in the values below.

# From https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Obtained once via the OAuth authorization-code flow (see README.md)
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# Your Discord account token (see README.md for how to find it).
# Keep this secret. Anyone with this token can fully control your account.
DISCORD_TOKEN=your_discord_user_token

# How often to poll Spotify, in milliseconds (default 4000 = 4s)
POLL_INTERVAL_MS=4000
